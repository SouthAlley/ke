#!name=哔哩哔哩
#!desc=没有广告的哔哩哔哩更值得干杯。
#!author=RuCu6[https://github.com/RuCu6], kokoryh[https://github.com/kokoryh], 可莉🅥[https://gitlab.com/lodepuly/vpn_tool]
#!icon=https://rucu6.pages.dev/Icons/app/bilibili.png
#!date=2026-08-30 10:10
#!loon_version=3.5.1(978)
#!arguments=displayUpList:"auto",optimizeRequest:true,purifyComment:true,sponsorBlock:true
#!arguments-desc=displayUpList: 显示 动态「最常访问」\n- auto: 仅当列表中存在直播状态时显示\n- show: 始终显示\n- hide: 始终隐藏\n\noptimizeRequest: 过滤「视频内」插播广告\n自动跳过视频内广告\n- true: 开启\n- false: 关闭\n\npurifyComment: 过滤「评论区」置顶广告\n-true: 开启\n- false: 关闭\n\nsponsorBlock: 空降助手

[Rule]
AND,((DOMAIN-SUFFIX,chat.bilibili.com,extended-matching),(OR,((DOMAIN-KEYWORD,stun,extended-matching),(DOMAIN-KEYWORD,tracker,extended-matching),(DOMAIN-KEYWORD,p2p,extended-matching)))),REJECT
# 备用域名
DOMAIN,api.biliapi.com,REJECT,extended-matching
DOMAIN,api.biliapi.net,REJECT,extended-matching
DOMAIN,app.biliapi.com,REJECT,extended-matching
DOMAIN,app.biliapi.net,REJECT,extended-matching
# 开屏广告
URL-REGEX,"^http:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH",REJECT-TINYGIF,extended-matching
URL-REGEX,"^http:\/\/[\d\.]+:8000\/v1\/resource\/\w{32}-1-SPLASH",REJECT-TINYGIF,extended-matching

[MITM]
hostname = %APPEND% *live.bilibili.com, *api.biligame.com, ap?.bilibili.com, grpc.biliapi.net, m.bilibili.com, manga.bilibili.com, www.bilibili.com

